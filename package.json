{
  "name": "lotm-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "LOTM sandbox — pi coding agent interactive narrative RPG (Lord of Mysteries)",
  "keywords": [
    "interactive-fiction",
    "lord-of-mysteries",
    "lotm",
    "pi-card",
    "pi-package",
    "rpg"
  ],
  "license": "GPL-3.0-or-later",
  "files": [
    "agents/",
    "data/",
    "engine/",
    "extensions/",
    "skills/",
    ".pi/agents/",
    ".pi/settings.json",
    "extension.ts",
    "start.sh",
    "scripts/package-release.sh",
    "README.md",
    "CHANGELOG.md",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    ".oxlintrc.json",
    ".oxfmtrc.json",
    "LICENSE",
    "start.ps1"
  ],
  "type": "module",
  "scripts": {
    "start": "./start.sh",
    "deps:install": "pnpm install --prod",
    "pack:release": "bash scripts/package-release.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test 'engine/**/*.test.ts' 'tests/**/*.test.ts' 'extensions/**/*.test.ts'",
    "audit:session": "node scripts/audit-session.ts",
    "export:book": "node scripts/export-book.ts",
    "export:book:html": "node scripts/export-book.ts --html",
    "deadcode": "pnpx knip --include files"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.79.9",
    "@earendil-works/pi-coding-agent": "^0.79.9",
    "@earendil-works/pi-tui": "^0.79.9",
    "@js-temporal/polyfill": "^0.5.1",
    "mermaid": "^11.16.0",
    "typebox": "^1.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "jiti": "^2.7.0",
    "oxfmt": "latest",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0"
}
